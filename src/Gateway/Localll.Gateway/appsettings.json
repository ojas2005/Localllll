{
  "Urls": "http://localhost:8080",
  "Jwt": {
    "Issuer": "localll-identity",
    "Audience": "localll",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "user",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "reviews": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/reviews/{**catch-all}"
        }
      },
      "grocery-catalog": {
        "ClusterId": "delivery",
        "Match": {
          "Path": "/api/v1/deliveries/grocery-catalog"
        }
      },
      "deliveries": {
        "ClusterId": "delivery",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/deliveries/{**catch-all}"
        }
      },
      "medicines": {
        "ClusterId": "medicine",
        "Match": {
          "Path": "/api/v1/medicines/{**catch-all}"
        }
      },
      "medicine-orders": {
        "ClusterId": "medicine",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/medicine-orders/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "wallets": {
        "ClusterId": "wallet",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/wallets/{**catch-all}"
        }
      },
      "appointments": {
        "ClusterId": "cybercafe",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/appointments/{**catch-all}"
        }
      },
      "partners": {
        "ClusterId": "partner",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/partners/{**catch-all}"
        }
      },
      "analytics": {
        "ClusterId": "analytics",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/analytics/{**catch-all}"
        }
      },
      "partner-applications": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/partner-applications/{**catch-all}"
        }
      },
      "store": {
        "ClusterId": "storeorders",
        "Match": {
          "Path": "/api/v1/store/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "user": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "delivery": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "medicine": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "wallet": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5006/"
          }
        }
      },
      "cybercafe": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5008/"
          }
        }
      },
      "partner": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5009/"
          }
        }
      },
      "analytics": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5010/"
          }
        }
      },
      "storeorders": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5011/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}